{
  "name": "moneypilot",
  "private": true,
  "version": "1.0.0",
  "description": "MoneyPilot — Personal Banking Dashboard (demo/portfolio project)",
  "scripts": {
    "dev:web": "npm run dev --workspace moneypilot-web",
    "dev:api": "npm run dev --workspace moneypilot-api",
    "build:web": "npm run build --workspace moneypilot-web",
    "build:api": "npm run build --workspace moneypilot-api",
    "lint:web": "npm run lint --workspace moneypilot-web",
    "typecheck:web": "npm run typecheck --workspace moneypilot-web",
    "prisma:generate": "npm run prisma:generate --workspace moneypilot-api",
    "prisma:migrate": "npm run prisma:migrate --workspace moneypilot-api",
    "seed": "npm run seed --workspace moneypilot-api"
  },
  "workspaces": [
    "apps/*"
  ],
  "overrides": {
    "postcss": "^8.5.28"
  }
}
